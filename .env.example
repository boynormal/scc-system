# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/machine_maintenance"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ─── File Storage (Cloudflare R2 or AWS S3) ────────────────────────────────────
# STORAGE_* is unused legacy. Do not put SeaweedFS credentials here.
STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="machine-maintenance"
STORAGE_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ─── SeaweedFS S3 (server only — never NEXT_PUBLIC_) ─────────────────────────
# Local process on the same host: http://127.0.0.1:8333
# Docker: http://<seaweed-service>:8333
# This server, after Cloudflare allows the ERP: https://s3.scharoenchai.cloud
S3_ENDPOINT="http://127.0.0.1:8333"
S3_REGION="us-east-1"
S3_BUCKET="erp"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_REQUEST_TIMEOUT_MS="30000"
S3_MAX_UPLOAD_BYTES="10485760"

# ─── Email (Resend.com) ────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Machine Maintenance System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── GPS Tracker (thaigpstracker.co.th) ────────────────────────────────────────
GPS_API_URL="https://gps.thaigpstracker.co.th/api2/map/getRealTimeData"
GPS_API_AUTH="Basic <base64-encoded-credentials>"
GPS_ASSET_ID="2013"

# ─── Cron (Bearer token for /api/cron/*) ───────────────────────────────────────
CRON_SECRET="change-this-to-a-long-random-cron-secret"
