// ─── GROUP 9: HR / PERSONNEL & TIME ATTENDANCE (import จาก Excel รูปแบบบันทึกเวลา) ─

model Personnel {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  rosterNo    String    @map("roster_no") @db.VarChar(30)
  displayName String    @map("display_name") @db.VarChar(255)
  jobGroup    String?   @map("job_group") @db.VarChar(100)
  firstName   String?   @map("first_name") @db.VarChar(100)
  lastName    String?   @map("last_name") @db.VarChar(100)
  idCardNo    String?   @map("id_card_no") @db.VarChar(30)
  phone       String?   @db.VarChar(30)
  address     String?   @db.Text
  notes       String?   @db.Text
  userId      String?   @unique @map("user_id") @db.Uuid
