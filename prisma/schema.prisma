  part   SparePart @relation(fields: [partId], references: [id])
  branch Branch    @relation(fields: [branchId], references: [id])

  @@unique([partId, branchId])
  @@map("spare_part_inventory")
}

model SparePartTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partId          String          @map("part_id") @db.Uuid
  branchId        String          @map("branch_id") @db.Uuid
  workOrderId     String?         @map("work_order_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  balanceAfter    Int             @map("balance_after")
  unitCost        Decimal?        @map("unit_cost") @db.Decimal(12, 2)
  referenceNo     String?         @map("reference_no") @db.VarChar(50)
  remark          String?
  createdBy       String?         @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  part      SparePart  @relation(fields: [partId], references: [id])
  branch    Branch     @relation(fields: [branchId], references: [id])
