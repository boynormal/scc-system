  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  userId    String?     @map("user_id") @db.Uuid
  tableName String      @map("table_name") @db.VarChar(100)
