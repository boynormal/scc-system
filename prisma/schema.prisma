  rowCount    Int       @default(0) @map("row_count")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  company   Company           @relation(fields: [companyId], references: [id])
  branch    Branch            @relation(fields: [branchId], references: [id])
  createdBy User?             @relation("AttendanceImportAuthor", fields: [createdById], references: [id])
  entries   AttendanceEntry[]

  @@index([companyId, createdAt])
  @@map("attendance_import_batches")
}

model AttendanceEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  personnelId   String   @map("personnel_id") @db.Uuid
  workDate      DateTime @map("work_date") @db.Date
  punchTimes    String[] @map("punch_times")
  importBatchId String?  @map("import_batch_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company     Company                @relation(fields: [companyId], references: [id])
  branch      Branch                 @relation(fields: [branchId], references: [id])
  personnel   Personnel              @relation(fields: [personnelId], references: [id])
  importBatch AttendanceImportBatch? @relation(fields: [importBatchId], references: [id])

  @@unique([personnelId, workDate], map: "attendance_entry_person_date_unique")
  @@index([companyId, workDate])
  @@index([branchId, workDate])
  @@map("attendance_entries")
}

// ─── TRANSPORT MANAGEMENT SYSTEM (TMS) ───────────────────────────────────────

enum VehicleStatus {
  available
  on_job
  maintenance
  inactive
}

enum TransportJobStatus {
  pending_assignment
  assigned
  driver_accepted
  en_route
  at_pickup
  loading
  departed
  at_destination
  unloading
  completed
  cancelled
}

enum StopStatus {
  pending
  arrived
  loading
  completed
  skipped
  cancelled
}

enum TransportJobPriority {
  low
  normal
  high
  urgent
}

enum TransportRepairStatus {
  reported
  in_repair
  inspection
  closed
  cancelled
}

enum TransportTireWorkType {
  change
  patch
  repair
}

enum TransportPaymentMethod {
  cash
  credit
}

enum AttachmentStage {
  before_trip
  at_pickup
  transit
  at_delivery
  after_trip
}

model TmsCustomer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String?  @db.VarChar(50)
  name        String   @db.VarChar(255)
  contactName String?  @map("contact_name") @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  address     String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  details     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company        @relation(fields: [companyId], references: [id])
  jobs    TransportJob[]

  @@index([companyId])
  @@map("tms_customers")
}

model TransportJobType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(100)
  details   String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("transport_job_types")
}

model TransportCargoType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(100)
  details   String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("transport_cargo_types")
}

model TransportVehicleType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(100)
  details     String?
  wheelCount  Int?     @map("wheel_count")
  wheelLayout Json?    @map("wheel_layout") // number[][] e.g. [[1,2],[3,4,5,6]]
