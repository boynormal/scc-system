  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("transport_vehicle_types")
}

model TransportVehicle {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  plateNumber    String        @map("plate_number") @db.VarChar(20)
  name           String        @db.VarChar(100)
  vehicleType    String        @map("vehicle_type") @db.VarChar(50)
  maxWeightKg    Decimal?      @map("max_weight_kg") @db.Decimal(10, 2)
  loadCapacityKg Decimal?      @map("load_capacity_kg") @db.Decimal(10, 2)
  volumeM3       Decimal?      @map("volume_m3") @db.Decimal(8, 2)
  gpsDeviceId    String?       @map("gps_device_id") @db.VarChar(100)
  currentStatus  VehicleStatus @default(available) @map("current_status")
  mileage        Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  company     Company              @relation(fields: [companyId], references: [id])
  branch      Branch               @relation(fields: [branchId], references: [id])
  assignments JobAssignment[]
  attachments JobAttachment[]
  drivers     Driver[]
  repairLogs  TransportRepairLog[]
  tireLogs    TransportTireLog[]

  @@index([companyId])
  @@index([branchId])
  @@index([gpsDeviceId])
  @@map("transport_vehicles")
}

model TransportTireLog {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  vehicleId     String                @map("vehicle_id") @db.Uuid
  workDate      DateTime              @map("work_date") @db.Timestamptz
  /// [{ position: number, workType: TransportTireWorkType }, ...]
  wheels        Json
  cost          Decimal?              @db.Decimal(12, 2)
  paymentMethod TransportPaymentMethod? @map("payment_method")
  notes         String?
  createdById   String                @map("created_by_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  company   Company          @relation(fields: [companyId], references: [id])
  branch    Branch           @relation(fields: [branchId], references: [id])
  vehicle   TransportVehicle @relation(fields: [vehicleId], references: [id])
  createdBy User             @relation("TireLogCreatedBy", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([vehicleId])
  @@index([workDate])
  @@index([vehicleId, workDate])
  @@map("transport_tire_logs")
}

model TransportRepairLog {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  branchId        String                @map("branch_id") @db.Uuid
  vehicleId       String                @map("vehicle_id") @db.Uuid
  symptom         String
  notes           String?
  status          TransportRepairStatus @default(reported)
  reportedById    String                @map("reported_by_id") @db.Uuid
  reportedAt      DateTime              @default(now()) @map("reported_at") @db.Timestamptz
  startedById     String?               @map("started_by_id") @db.Uuid
  startedAt       DateTime?             @map("started_at") @db.Timestamptz
  closedById      String?               @map("closed_by_id") @db.Uuid
  closedAt        DateTime?             @map("closed_at") @db.Timestamptz
  mileageAtReport Decimal?              @map("mileage_at_report") @db.Decimal(12, 2)
  repairCost      Decimal?              @map("repair_cost") @db.Decimal(12, 2)
  paymentMethod   TransportPaymentMethod? @map("payment_method")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  company    Company         @relation(fields: [companyId], references: [id])
  branch     Branch          @relation(fields: [branchId], references: [id])
  vehicle    TransportVehicle @relation(fields: [vehicleId], references: [id])
  reportedBy User            @relation("RepairReportedBy", fields: [reportedById], references: [id])
  startedBy  User?           @relation("RepairStartedBy", fields: [startedById], references: [id])
  closedBy   User?           @relation("RepairClosedBy", fields: [closedById], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([vehicleId])
  @@index([status])
  @@index([vehicleId, status])
  @@map("transport_repair_logs")
}

model Driver {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  code                 String        @db.VarChar(50)
  firstName            String        @map("first_name") @db.VarChar(100)
  lastName             String        @map("last_name") @db.VarChar(100)
  phone                String?       @db.VarChar(30)
  licenseNumber        String?       @map("license_number") @db.VarChar(50)
  licenseExpiry        DateTime?     @map("license_expiry") @db.Date
  licenseTypes         Json          @default("[]") @map("license_types")
  drivableVehicleTypes Json          @default("[]") @map("drivable_vehicle_types")
  currentStatus        VehicleStatus @default(available) @map("current_status")
  assignedVehicleId    String?       @map("assigned_vehicle_id") @db.Uuid
