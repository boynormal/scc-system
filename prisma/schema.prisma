   */
  branchAssignments PersonnelBranch[]

  @@unique([companyId, rosterNo], map: "personnel_company_roster_unique")
  @@index([companyId])
  @@index([branchId])
  @@index([displayName])
  @@map("personnel")
}

model PersonnelBranch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personnelId String   @map("personnel_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  personnel Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([personnelId, branchId], map: "personnel_branch_unique")
  @@index([branchId])
  @@map("personnel_branches")
}

model AttendanceImportBatch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
